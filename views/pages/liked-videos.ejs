<div class="container mt-4">
    <h2 class="fw-bold mb-4">Vídeos Curtidos</h2>
    <% if (videos && videos.length> 0) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% videos.forEach(video=> { %>
                <div class="col">
                    <div class="card video-card h-100 shadow-sm border-0">
                        <a href="/video/<%= video.id %>">
                            <img src="/uploads/covers/<%= video.thumbnailPath %>" class="card-img-top"
                                alt="<%= video.title %>">
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate mb-1"><a href="/video/<%= video.id %>"
                                    class="text-decoration-none text-dark">
                                    <%= video.title %>
                                </a></h5>
                            <p class="card-text text-muted small mb-2">
                                <a href="/profile/@<%= video.User.username %>" class="text-decoration-none text-muted">
                                    @<%= video.User.username %>
                                </a>
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <small class="text-muted">
                                    <%= video.views %> visualizações
                                </small>
                                <small class="text-muted">
                                    <%= new Date(video.createdAt).toLocaleDateString() %>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>
        <% } else { %>
            <div class="alert alert-info text-center" role="alert">
                Você ainda não curtiu nenhum vídeo.
            </div>
            <% } %>
</div>