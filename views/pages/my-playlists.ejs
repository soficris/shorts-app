<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-4">Minhas Playlists</h2>
            <!-- Formulário para criar nova playlist -->
            <div class="card mb-4">
                <div class="card-header">Criar Nova Playlist</div>
                <div class="card-body">
                    <form action="/playlist" method="POST">
                        <div class="mb-3"><label for="title" class="form-label">Título da Playlist</label>
                            <input type="text" class="form-control" id="title" name="title" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Descrição (Opcional)</label>
                            <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="isPublic" name="isPublic">
                            <label class="form-check-label" for="isPublic">
                                Playlist Pública
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary">Criar Playlist</button>
                    </form>
                </div>
            </div>
            <!-- Lista de Playlists -->
            <% if (playlists && playlists.length> 0) { %>
                <div class="list-group">
                    <% playlists.forEach(playlist=> { %>
                        <a href="/playlist/<%= playlist.id %>"
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">
                                    <%= playlist.title %>
                                </h5>
                                <p class="mb-1 text-muted small">
                                    <%= playlist.description || 'Sem descrição' %>
                                </p>
                                <small class="text-muted">
                                    <%= playlist.videosCount %> vídeos
                                </small>
                            </div>
                            <div>
                                <% if (playlist.isPublic) { %>
                                    <span class="badge bg-success me-2">Pública</span>
                                    <% } else { %>
                                        <span class="badge bg-info me-2">Privada</span>
                                        <% } %>
                                            <form action="/playlist/<%= playlist.id %>/delete" method="POST"
                                                class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Tem certeza que deseja excluir esta playlist?');">Excluir</button>
                                            </form>
                            </div>
                        </a>
                        <% }); %>
                </div>
                <% } else { %>
                    <div class="alert alert-info text-center" role="alert">
                        Você ainda não criou nenhuma playlist. Crie uma acima!
                    </div>
                    <% } %>
        </div>
    </div>
</div>