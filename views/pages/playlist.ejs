<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="playlist-header mb-4">
                <h2 class="fw-bold mb-1">
                    <%= playlist.title %>
                </h2>
                <p class="text-muted">Criada por: <a href="/profile/@<%= playlist.User.username %>"
                        class="text-decoration-none">@<%= playlist.User.username %></a></p>
                <% if (playlist.description) { %>
                    <p class="mb-3">
                        <%= playlist.description %>
                    </p>
                    <% } %>
                        <% if (playlist.isPublic) { %>
                            <span class="badge bg-success">Pública</span>
                            <% } else { %>
                                <span class="badge bg-info">Privada</span>
                                <% } %>
            </div>
            <h4 class="fw-bold mb-3">Vídeos na Playlist (<%= playlist.Videos.length %>)</h4>
            <div class="row g-4">
                <% if (playlist.Videos && playlist.Videos.length> 0) { %>
                    <% playlist.Videos.forEach(video=> { %>
                        <div class="col-6 col-md-4 col-lg-4">
                            <div class="video-card">
                                <a href="/video/<%= video.id %>">
                                    <div class="thumbnail-placeholder"
                                        style="background-image: url('/uploads/covers/<%= video.thumbnailPath %>');">
                                        <i class="bi bi-play-circle play-icon"></i>
                                        <span class="badge-views"><i class="bi bi-eye"></i>
                                            <%= video.views %>
                                        </span>
                                    </div>
                                </a>
                                <div class="p-3">
                                    <h6 class="text-truncate mb-1"><a href="/video/<%= video.id %>"
                                            class="text-decoration-none text-dark">
                                            <%= video.title %>
                                        </a></h6>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= playlist.User.profilePicture ?
                                            '/uploads/profiles/' + playlist.User.profilePicture :
                                            '/images/default-profile.png' %>" alt="<%= playlist.User.username %>" class="rounded-circle me-2" width="24"
                                            height="24">
                                        <span class="text-muted small">@<%= playlist.User.username %></span>
                                    </div>
                                    <% if (user && user.id===playlist.userId) { %>
                                        <form action="/playlist/remove-video" method="POST" class="mt-2">
                                            <input type="hidden" name="playlistId" value="<%= playlist.id %>">
                                            <input type="hidden" name="videoId" value="<%= video.id %>">
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Remover da
                                                Playlist
                                            </button>
                                        </form>
                                        <% } %>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="col-12">
                                    <div class="alert alert-info text-center" role="alert">
                                        Esta playlist ainda não possui vídeos.
                                    </div>
                                </div>
                                <% } %>
            </div>
        </div>
    </div>
</div>