<div class="container mt-4">
    <div class="row">
        <!-- 1ª Coluna: Vídeo -->
        <div class="col-12 col-lg-4 d-flex justify-content-center">
            <div class="video-player-container mb-4">
                <video controls class="w-100 rounded shadow-sm" poster="/uploads/covers/<%= video.thumbnailPath %>">
                    <source src="/video/<%= video.id %>/stream" type="video/mp4">
                    Seu navegador não suporta a tag de vídeo.
                </video>
            </div>
        </div>
        <!-- 2ª Coluna: Dados do Autor/Vídeo e Comentários -->
        <div class="col-12 col-lg-4">
            <h1 class="h4 fw-bold mb-2">
                <%= video.title %>
            </h1>
            <div class="d-flex align-items-center mb-3">
                <img src="<%= video.User.profilePicture ?
'/uploads/profiles/' + video.User.profilePicture :
'/images/default-profile.png' %>" alt="<%= video.User.username %>" class="rounded-circle me-2" width="40" height="40">
                <div>
                    <h6 class="mb-0">
                        <%= video.User.fullName %>
                    </h6>
                    <small class="text-muted">@<%= video.User.username %></small>
                </div>
                <span class="ms-auto text-muted small">
                    <%= video.views %> visualizações
                </span>
            </div>
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <p class="card-text">
                        <%= video.description %>
                    </p>
                </div>
            </div>
            <!-- Botão de Like, Adicionar à Playlist e Contagem de Comentários -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <button id="likeButton" class="btn btn-light btn-sm rounded-pill px-3 d-flex align-items-center">
                    <i class="bi <%= isLiked ? 'bi-heart-fill text-danger' : 'bi-heart' %> me-2"></i>
                    <span id="likesCount">
                        <%= video.likesCount %>
                    </span>
                </button>
                <% if (user) { %>
                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3 d-flex align-items-center"
                        data-bs-toggle="modal" data-bs-target="#addToPlaylistModal">
                        <i class="bi bi-plus-square me-2"></i> Adicionar à Playlist
                    </button>
                    <% } %>
                        <span class="text-muted">
                            <%= video.commentsCount %> Comentários
                        </span>
            </div>
            <!-- Seção de Comentários -->
            <div class="comments-section">
                <h5 class="mb-3">Comentários (<span id="commentsCountDisplay">
                        <%= video.commentsCount %>
                    </span>)</h5>
                <% if (user) { %>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Adicionar um comentário</h6>
                            <form id="commentForm">
                                <div class="mb-3">
                                    <textarea class="form-control" id="commentContent" rows="3"
                                        placeholder="Escreva seu comentário aqui..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">Comentar</button>
                            </form>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="alert alert-info text-center" role="alert">
                            Faça <a href="/login">login</a> para comentar.
                        </div>
                        <% } %>
                            <div id="commentsList" class="list-group list-group-flush">
                                <!-- Comentários serão carregados aqui via AJAX -->
                            </div>
            </div>
        </div>
        <!-- 3ª Coluna: Vídeos Sugeridos -->
        <div class="col-12 col-lg-4 mt-4 mt-lg-0">
            <h5 class="mb-3">Vídeos Sugeridos</h5>
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action d-flex align-items-center mb-2">
                    <img src="/images/placeholder-cover.jpg" alt="Capa do Vídeo" class="me-3 rounded" width="80"
                        height="50">
                    <div>
                        <h6 class="mb-0 text-truncate">Título do Vídeo Sugerido 1</h6>
                        <small class="text-muted">@usuario_sugerido</small>
                    </div>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex align-items-center mb-2">
                    <img src="/images/placeholder-cover.jpg" alt="Capa do Vídeo" class="me-3 rounded" width="80"
                        height="50">
                    <div>
                        <h6 class="mb-0 text-truncate">Título do Vídeo Sugerido 2</h6>
                        <small class="text-muted">@outro_usuario</small>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const videoId = "<%= video.id %>";
        const likeButton = document.getElementById("likeButton");
        const likesCountSpan = document.getElementById("likesCount");
        const commentForm = document.getElementById("commentForm");
        const commentContent = document.getElementById("commentContent");
        const commentsList = document.getElementById("commentsList");
        const commentsCountDisplay = document.getElementById("commentsCountDisplay");
        // Função para carregar comentários
        async function loadComments() {
            try {
                const response = await fetch(`/video/${videoId}/comments`);
                const data = await response.json();
                if (response.ok) {
                    commentsList.innerHTML = ""; // Limpa a lista atual
                    if (data.comments.length > 0) {
                        data.comments.forEach(comment => {
                            const commentElement = `
                                <div class="list-group-item d-flex align-items-start mb-2">
                                <img src="${comment.User.profilePicture ?
                                                                    '/uploads/profiles/' + comment.User.profilePicture :
                                                                    '/images/default-profile.png'}"
                                alt="${comment.User.username}" class="rounded-circle me-3" width="40" height="40">
                                <div>
                                <h6 class="mb-0">${comment.User.fullName}
                                <small class="text-muted">@${comment.User.username}
                                </small>
                                </h6><p class="mb-1">${comment.content}</p>
                                <small class="text-muted">${new Date(comment.createdAt).toLocaleString()}</small>
                                </div>
                                </div>
                                `;
                            commentsList.insertAdjacentHTML("beforeend", commentElement);
                        });
                    } else {
                        commentsList.innerHTML =
                            `<div class="alert alert-info text-center" role="alert">
                                Nenhum comentário ainda. Seja o primeiro a comentar!
                            </div>`;
                    }
                    commentsCountDisplay.textContent = data.comments.length;
                } else {
                    console.error("Erro ao carregar comentários:", data.message);
                }
            } catch (error) {
                console.error("Erro de rede ao carregar comentários:", error);
            }
        }
        // Carrega os comentários ao carregar a página
        loadComments();
        // Lógica para o botão de like
        if (likeButton) {
            likeButton.addEventListener("click", async () => {
                try {
                    const response = await fetch(`/video/${videoId}/toggle-like`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    }); const data = await response.json();
                    if (response.ok) {
                        let currentLikes = parseInt(likesCountSpan.textContent);
                        if (data.liked) {
                            likesCountSpan.textContent = currentLikes + 1;
                            likeButton.querySelector("i").classList.remove("bi-heart");
                            likeButton.querySelector("i").classList.add("bi-heart-fill", "text-danger");
                        } else {
                            likesCountSpan.textContent = currentLikes - 1;
                            likeButton.querySelector("i").classList.remove("bi-heart-fill", "text-danger");
                            likeButton.querySelector("i").classList.add("bi-heart");
                        }
                    } else {
                        alert(data.message || "Erro ao processar o like.");
                    }
                } catch (error) {
                    console.error("Erro de rede ao alternar like:", error);
                    alert("Erro de rede ao processar o like.");
                }
            });
        }
        // Lógica para o formulário de comentário
        if (commentForm) {
            commentForm.addEventListener("submit", async (e) => {
                e.preventDefault();
                const content = commentContent.value;
                try {
                    const response = await fetch(`/video/${videoId}/comment`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ content })
                    });
                    const data = await response.json();
                    if (response.ok) {
                        commentContent.value = ""; // Limpa o campo de texto
                        loadComments(); // Recarrega os comentários
                    } else {
                        alert(data.message || "Erro ao adicionar comentário.");
                    }
                } catch (error) {
                    console.error("Erro de rede ao adicionar comentário:", error);
                    alert("Erro de rede ao adicionar comentário.");
                }
            });
        }
        // Lógica para o modal de adicionar à playlist
        const addToPlaylistModal = document.getElementById("addToPlaylistModal");
        if (addToPlaylistModal) {
            addToPlaylistModal.addEventListener("show.bs.modal", async (event) => {
                const playlistList = document.getElementById("playlistList");
                playlistList.innerHTML =
                    `<div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                    </div>`;
                try {
                    const response = await fetch(`/playlists/video/${videoId}/status`);
                    const data = await response.json();
                    if (response.ok) {
                        playlistList.innerHTML = ""; if (data.playlists.length > 0) {
                            data.playlists.forEach(playlist => {
                                const isChecked = playlist.hasVideo ? "checked" : "";
                                const playlistItem = `
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="${playlist.id}"
                                            id="playlist-${playlist.id}" ${isChecked}>
                                        <label class="form-check-label" for="playlist-${playlist.id}">
                                            ${playlist.title} ${playlist.isPublic ? "" : "<i class=\"bibi-lock-fill text-muted ms-1\"></i>"}
                                        </label>
                                    </div>
                                `;
                                playlistList.insertAdjacentHTML("beforeend", playlistItem);
                            });
                            // Adicionar event listeners para os checkboxes
                            playlistList.querySelectorAll(".form-check-input").forEach(checkbox => {
                                checkbox.addEventListener("change", async (e) => {
                                    const targetPlaylistId = e.target.value;
                                    const isAdding = e.target.checked;
                                    const url = isAdding ? "/playlist/add-video" : "/playlist/remove-video";

                                    try {
                                        const actionResponse = await fetch(url, {
                                        method: "POST",
                                        headers: {
                                            "Content-Type": "application/json"
                                        },
                                        body: JSON.stringify({ playlistId: targetPlaylistId, videoId: videoId })
                                    });
                                    const actionData = await actionResponse.json();

                                    if (!actionResponse.ok) {
                                        alert(actionData.message || "Erro ao atualizar playlist.");e.target.checked = !isAdding; // Reverter o estado do checkbox em caso de erro
                                    }
                                    } catch (error) {
                                        console.error("Erro de rede ao atualizar playlist:", error);
                                        alert("Erro de rede ao atualizar playlist.");
                                        e.target.checked = !isAdding; // Reverter o estado do checkbox em caso de erro
                                    }
                                });
                            });
                        } else {
                            playlistList.innerHTML =
                                `< div class= "alert alert-info" role = "alert" >
                                    Você ainda não tem playlists.Crie uma em "Minhas Playlists"!
                                </div > `;
                        }
                    } else {
                            alert(data.message || "Erro ao carregar playlists.");
                            playlistList.innerHTML =
                            `< div class= "alert alert-danger" role = "alert" >
                                Erro ao carregar playlists.
                            </div > `;
                    }
                } catch (error) {
                            console.error("Erro de rede ao carregar playlists:", error);
                            playlistList.innerHTML =
                            `< div class= "alert alert-danger" role = "alert" >
                                                        Erro de rede ao carregar playlists.
                            </div >`;
                }
            });
        }
    });
</script>

<!-- Modal Adicionar à Playlist -->
<div class="modal fade" id="addToPlaylistModal" tabindex="-1" aria-labelledby="addToPlaylistModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addToPlaylistModalLabel">Adicionar à Playlist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="playlistList">
                    <!-- Playlists serão carregadas aqui via AJAX -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>