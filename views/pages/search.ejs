<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-4">Resultados da Busca por "<%= query %>"</h2>
            <% if (searchResults.videos.length> 0) { %>
                <h4 class="fw-bold mb-3">Vídeos Encontrados</h4>
                <div class="row g-4 mb-5">
                    <% searchResults.videos.forEach(video=> { %>
                        <div class="col-6 col-md-4 col-lg-4">
                            <div class="video-card">
                                <a href="/video/<%= video.id %>">
                                    <div class="thumbnail-placeholder"
                                        style="background-image: url('/uploads/covers/<%= video.thumbnailPath %>');">
                                        <i class="bi bi-play-circle play-icon"></i>
                                        <span class="badge-views"><i class="bi bi-eye"></i>
                                            <%= video.views %>
                                        </span>
                                    </div>
                                </a>
                                <div class="p-3">
                                    <h6 class="text-truncate mb-1"><a href="/video/<%= video.id %>"
                                            class="text-decoration-none text-dark">
                                            <%= video.title %>
                                        </a></h6>
                                    <div class="d-flex align-items-center">
                                        <img src="<%= video.User.profilePicture ?
'/uploads/profiles/' + video.User.profilePicture :
'/images/default-profile.png' %>" alt="<%= video.User.username %>" class="rounded-circle me-2" width="24" height="24">
                                        <span class="text-muted small">@<%= video.User.username %></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                </div>
                <% } else { %>
                    <div class="alert alert-info text-center mb-5" role="alert">
                        Nenhum vídeo encontrado para "<%= query %>".
                    </div>
                    <% } %>
                        <% if (searchResults.users.length> 0) { %>
                            <h4 class="fw-bold mb-3">Usuários Encontrados</h4>
                            <div class="list-group mb-5">
                                <% searchResults.users.forEach(user=> { %>
                                    <a href="/profile/@<%= user.username %>"
                                        class="list-group-item list-group-item-action d-flex align-items-center">
                                        <img src="<%= user.profilePicture ?
'/uploads/profiles/' + user.profilePicture :
'/images/default-profile.png' %>" alt="<%= user.username %>" class="rounded-circle me-3" width="40" height="40">
                                        <div>
                                            <h5 class="mb-0">
                                                <%= user.fullName %>
                                            </h5>
                                            <small class="text-muted">@<%= user.username %></small>
                                        </div>
                                    </a>
                                    <% }); %>
                            </div>
                            <% } else { %>
                                <div class="alert alert-info text-center" role="alert">
                                    Nenhum usuário encontrado para "<%= query %>".
                                </div>
                                <% } %>
                                    <% if (searchResults.videos.length===0 && searchResults.users.length===0 && query) {
                                        %>
                                        <div class="alert alert-warning text-center" role="alert">
                                            Nenhum resultado encontrado para "<%= query %>".
                                        </div>
                                        <% } %>
        </div>
    </div>
</div>